datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DELEGATE
  CHAIR
  SECRETARIAT
  TRAINER
}

enum AttendanceStatus {
  PRESENT
  PRESENT_AND_VOTING
  ABSENT
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  passwordHash  String?
  image         String?
  role          Role                @default(DELEGATE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  participations CommitteeDelegate[]
}

model Committee {
  id          String              @id @default(cuid())
  name        String              // e.g., "UNSC", "UNGA DISEC"
  topic       String              // e.g., "Militarization of the Arctic"
  isLive      Boolean             @default(false)
  currentGSL  String[]            // Array of country names in queue
  delegates   CommitteeDelegate[]
  createdAt   DateTime            @default(now())
}

model CommitteeDelegate {
  id           String           @id @default(cuid())
  userId       String
  committeeId  String
  country      String           // e.g., "France", "Japan"
  status       AttendanceStatus @default(ABSENT)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee    Committee        @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@unique([userId, committeeId])
}
